<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>єКуратор ДТЕУ | Повнофункціональна система супроводу групи</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        sute: {
                            blue: '#0B2545',
                            red: '#8B0000',
                            accent: '#134074',
                            light: '#EEF4F8'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body { background: white; font-size: 11pt; color: black; }
        }
        .print-only { display: none; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen flex flex-col antialiased">

    <!-- TOP HEADER -->
    <header class="bg-sute-blue text-white shadow-lg no-print sticky top-0 z-40 border-b-4 border-sute-red">
        <div class="max-w-7xl mx-auto px-4 py-2.5 flex flex-wrap justify-between items-center gap-3">
            <div class="flex items-center space-x-3">
                <div class="bg-sute-red text-white font-extrabold px-2.5 py-1 rounded-md text-lg tracking-wider shadow">ДТЕУ</div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-base font-bold leading-none tracking-tight">ІС «єКуратор»</h1>
                        <span class="text-[10px] bg-blue-900/80 text-blue-200 px-2 py-0.5 rounded border border-blue-700 font-mono">v1.0 Release</span>
                    </div>
                    <p class="text-xs text-slate-300 mt-0.5">Академічна група: <span class="font-bold text-white">1-5</span> | Куратор: <span class="font-bold text-white">Ісіков Я. А.</span></p>
                </div>
            </div>

            <!-- GLOBAL SEARCH & DATA ACTIONS -->
            <div class="flex items-center space-x-2">
                <div class="relative">
                    <i data-lucide="search" class="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-slate-400"></i>
                    <input type="text" id="global-search" oninput="handleGlobalSearch(this.value)" placeholder="Пошук студента..." class="text-xs bg-slate-800 border border-slate-700 rounded-lg pl-8 pr-3 py-1.5 w-44 focus:w-60 focus:outline-none focus:border-blue-400 text-white transition-all placeholder-slate-400">
                </div>
                <button onclick="exportDatabase()" class="text-xs bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg flex items-center gap-1 border border-slate-700 transition" title="Експорт резервної копії JSON">
                    <i data-lucide="download" class="w-3.5 h-3.5 text-blue-400"></i> <span class="hidden sm:inline">Бекап</span>
                </button>
                <label class="text-xs bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg flex items-center gap-1 border border-slate-700 cursor-pointer transition" title="Відновити з файлу">
                    <i data-lucide="upload" class="w-3.5 h-3.5 text-emerald-400"></i> <span class="hidden sm:inline">Імпорт</span>
                    <input type="file" id="importFile" class="hidden" onchange="importDatabase(event)">
                </label>
                <button onclick="resetToSampleData()" class="text-xs bg-red-950/80 hover:bg-red-900 text-red-200 border border-red-800/60 px-2.5 py-1.5 rounded-lg" title="Скинути до зразка">
                    Зразок
                </button>
            </div>
        </div>

        <!-- 8-MODULE NAVIGATION -->
        <nav class="max-w-7xl mx-auto px-4 flex space-x-1 border-t border-slate-800/80 overflow-x-auto custom-scrollbar text-xs font-semibold py-1">
            <button onclick="switchTab('tab-dash')" id="btn-tab-dash" class="nav-tab active-tab py-2 px-3 rounded flex items-center gap-1.5 whitespace-nowrap">
                <i data-lucide="layout-dashboard" class="w-4 h-4"></i> Дашборд
            </button>
            <button onclick="switchTab('tab-housing')" id="btn-tab-housing" class="nav-tab py-2 px-3 rounded flex items-center gap-1.5 text-slate-300 hover:text-white whitespace-nowrap">
                <i data-lucide="home" class="w-4 h-4 text-amber-400"></i> 1. Поселення
            </button>
            <button onclick="switchTab('tab-attendance')" id="btn-tab-attendance" class="nav-tab py-2 px-3 rounded flex items-center gap-1.5 text-slate-300 hover:text-white whitespace-nowrap">
                <i data-lucide="calendar-check" class="w-4 h-4 text-emerald-400"></i> 2. Відвідуваність
            </button>
            <button onclick="switchTab('tab-academic')" id="btn-tab-academic" class="nav-tab py-2 px-3 rounded flex items-center gap-1.5 text-slate-300 hover:text-white whitespace-nowrap">
                <i data-lucide="graduation-cap" class="w-4 h-4 text-blue-400"></i> 3. Успішність і борги
            </button>
            <button onclick="switchTab('tab-rating')" id="btn-tab-rating" class="nav-tab py-2 px-3 rounded flex items-center gap-1.5 text-slate-300 hover:text-white whitespace-nowrap">
                <i data-lucide="award" class="w-4 h-4 text-purple-400"></i> 4. Стипендія
            </button>
            <button onclick="switchTab('tab-military')" id="btn-tab-military" class="nav-tab py-2 px-3 rounded flex items-center gap-1.5 text-slate-300 hover:text-white whitespace-nowrap">
                <i data-lucide="shield" class="w-4 h-4 text-orange-400"></i> 5. Військовий облік / Документи
            </button>
            <button onclick="switchTab('tab-social')" id="btn-tab-social" class="nav-tab py-2 px-3 rounded flex items-center gap-1.5 text-slate-300 hover:text-white whitespace-nowrap">
                <i data-lucide="heart-handshake" class="w-4 h-4 text-rose-400"></i> 6. Соцпаспорт / Кейси
            </button>
            <button onclick="switchTab('tab-safety')" id="btn-tab-safety" class="nav-tab py-2 px-3 rounded flex items-center gap-1.5 text-slate-300 hover:text-white whitespace-nowrap">
                <i data-lucide="compass" class="w-4 h-4 text-teal-400"></i> 7. Адаптація та Безпека
            </button>
            <button onclick="switchTab('tab-reports')" id="btn-tab-reports" class="nav-tab py-2 px-3 rounded flex items-center gap-1.5 text-slate-300 hover:text-white whitespace-nowrap">
                <i data-lucide="file-text" class="w-4 h-4 text-yellow-400"></i> 8. Звітність деканату
            </button>
        </nav>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 py-5 flex-1 w-full no-print">

        <!-- DASHBOARD (OVERVIEW OF ALL 8 MODULES) -->
        <div id="tab-dash" class="module-tab block space-y-5">
            <!-- CRITICAL DETECTOR ALERTS (AUTODETECTION) -->
            <div id="dash-alerts-container" class="space-y-2"></div>

            <!-- METRIC CARDS -->
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
                <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm">
                    <span class="text-[11px] font-bold text-slate-400 uppercase">Студентів у групі</span>
                    <p class="text-2xl font-black text-slate-800 mt-1" id="dash-stat-total">0</p>
                    <span class="text-[10px] text-slate-500">Група 1-5 ДТЕУ</span>
                </div>
                <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm">
                    <span class="text-[11px] font-bold text-amber-600 uppercase">Поселення</span>
                    <p class="text-2xl font-black text-amber-600 mt-1" id="dash-stat-dorm">0/0</p>
                    <span class="text-[10px] text-slate-500">Заселено / Потребують</span>
                </div>
                <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm">
                    <span class="text-[11px] font-bold text-emerald-600 uppercase">Відвідуваність</span>
                    <p class="text-2xl font-black text-emerald-600 mt-1" id="dash-stat-att">0%</p>
                    <span class="text-[10px] text-slate-500">Середня по групі</span>
                </div>
                <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm">
                    <span class="text-[11px] font-bold text-rose-600 uppercase">Група ризику</span>
                    <p class="text-2xl font-black text-rose-600 mt-1" id="dash-stat-risk">0</p>
                    <span class="text-[10px] text-slate-500">Борги / Пропуски</span>
                </div>
                <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm">
                    <span class="text-[11px] font-bold text-purple-600 uppercase">Стипендіати</span>
                    <p class="text-2xl font-black text-purple-600 mt-1" id="dash-stat-stip">0</p>
                    <span class="text-[10px] text-slate-500">У рейтинговому пулі</span>
                </div>
                <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm">
                    <span class="text-[11px] font-bold text-blue-600 uppercase">Пільгові категорії</span>
                    <p class="text-2xl font-black text-blue-600 mt-1" id="dash-stat-benefit">0</p>
                    <span class="text-[10px] text-slate-500">Соцпаспорт</span>
                </div>
            </div>

            <!-- REGISTRY TABLE -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="p-4 bg-slate-50 border-b border-slate-200 flex flex-wrap justify-between items-center gap-3">
                    <div>
                        <h2 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                            <i data-lucide="users" class="w-4 h-4 text-sute-blue"></i> Наскрізний реєстр академічної групи 1-5
                        </h2>
                        <p class="text-xs text-slate-500">Єдина база студентів з автоматичною агрегацією даних з усіх модулів</p>
                    </div>
                    <button onclick="openStudentModal()" class="bg-sute-blue hover:bg-sute-accent text-white text-xs font-semibold px-3 py-2 rounded-lg flex items-center gap-1.5 shadow-sm transition">
                        <i data-lucide="user-plus" class="w-4 h-4"></i> Додати студента
                    </button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-100 uppercase text-slate-500 font-bold border-b border-slate-200">
                            <tr>
                                <th class="p-3">ПІБ Студента</th>
                                <th class="p-3">Форма / Стать</th>
                                <th class="p-3">Гуртожиток</th>
                                <th class="p-3">Пропуски (Н)</th>
                                <th class="p-3">Академборги</th>
                                <th class="p-3">Пільга / Соцстатус</th>
                                <th class="p-3">ТЦК / Військовий</th>
                                <th class="p-3 text-right">Картка</th>
                            </tr>
                        </thead>
                        <tbody id="dash-students-table" class="divide-y divide-slate-100">
                            <!-- Populated by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- MODULE 1: HOUSING (SUTE-HOUSING) -->
        <div id="tab-housing" class="module-tab hidden space-y-5">
            <div class="bg-white p-4 rounded-xl border border-slate-200 flex justify-between items-center flex-wrap gap-3">
                <div>
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <i data-lucide="home" class="w-5 h-5 text-amber-600"></i> Модуль 1: Поселення та студмістечко ДТЕУ
                    </h2>
                    <p class="text-xs text-slate-500">Повний 4-етапний цикл: аудит, тайм-слоти, live-маршрут очного дня та дефекти</p>
                </div>
                <div class="flex gap-2">
                    <span class="text-xs bg-amber-50 text-amber-800 border border-amber-200 px-3 py-1.5 rounded-lg font-medium">
                        Квота групи: <b>15 місць</b>
                    </span>
                </div>
            </div>

            <!-- LIVE ROUTE (5 STEPS PIPELINE) -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
                <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-100">
                    <h3 class="font-bold text-sm text-slate-800 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        Етап ІІІ: Цифровий очний маршрут поселення (26–31 серпня)
                    </h3>
                    <span class="text-xs text-slate-400">Штаб ➔ Медпункт ➔ Оплата ➔ Комендант ➔ Кімната</span>
                </div>
                <div id="housing-live-cards" class="space-y-3">
                    <!-- Populated by JS -->
                </div>
            </div>

            <!-- DEFECTS LOG -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="font-bold text-sm text-slate-800 flex items-center gap-2">
                        <i data-lucide="alert-triangle" class="w-4 h-4 text-amber-500"></i> Дефектна відомість кімнат (Етап IV)
                    </h3>
                    <button onclick="openDefectModal()" class="text-xs bg-amber-600 hover:bg-amber-700 text-white font-semibold px-3 py-1.5 rounded-lg">
                        + Додати дефект кімнати
                    </button>
                </div>
                <div id="housing-defects-table" class="space-y-2">
                    <!-- Populated by JS -->
                </div>
            </div>
        </div>

        <!-- MODULE 2: ATTENDANCE -->
        <div id="tab-attendance" class="module-tab hidden space-y-5">
            <div class="bg-white p-4 rounded-xl border border-slate-200 flex justify-between items-center flex-wrap gap-3">
                <div>
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <i data-lucide="calendar-check" class="w-5 h-5 text-emerald-600"></i> Модуль 2: Відвідуваність та дисципліна
                    </h2>
                    <p class="text-xs text-slate-500">Облік пар, валідація медичних довідок та автодетектор хронічних пропусків (>20%)</p>
                </div>
                <button onclick="openAddAbsenceModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-3 py-2 rounded-lg">
                    + Внести пропуски занять
                </button>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 font-bold uppercase text-slate-500 border-b">
                        <tr>
                            <th class="p-3">Студент</th>
                            <th class="p-3">Всього пропущено пар</th>
                            <th class="p-3">Без поважної причини (Н)</th>
                            <th class="p-3">Поважні / Довідки (ПП)</th>
                            <th class="p-3">% пропусків</th>
                            <th class="p-3">Статус ризику</th>
                            <th class="p-3 text-right">Дії</th>
                        </tr>
                    </thead>
                    <tbody id="attendance-table-body" class="divide-y divide-slate-100">
                        <!-- Populated by JS -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- MODULE 3: ACADEMIC & DEBTS -->
        <div id="tab-academic" class="module-tab hidden space-y-5">
            <div class="bg-white p-4 rounded-xl border border-slate-200 flex justify-between items-center flex-wrap gap-3">
                <div>
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <i data-lucide="graduation-cap" class="w-5 h-5 text-blue-600"></i> Модуль 3: Успішність та академічні заборгованості
                    </h2>
                    <p class="text-xs text-slate-500">Контроль сесії, дедлайни «бігунців» та предиктивний аналіз ризику відрахування</p>
                </div>
                <button onclick="openAddDebtModal()" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold px-3 py-2 rounded-lg">
                    + Зафіксувати академборг
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Debts Tracker -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 space-y-3">
                    <h3 class="font-bold text-sm text-slate-800 flex items-center gap-2">
                        <i data-lucide="clock" class="w-4 h-4 text-rose-500"></i> Активні «Бігунці» та хвости
                    </h3>
                    <div id="debts-list-container" class="space-y-2">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Risk Group Analysis -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 space-y-3">
                    <h3 class="font-bold text-sm text-slate-800 flex items-center gap-2">
                        <i data-lucide="alert-octagon" class="w-4 h-4 text-rose-600"></i> Автоматична «Група ризику»
                    </h3>
                    <div id="academic-risk-container" class="space-y-2">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>
        </div>

        <!-- MODULE 4: SCHOLARSHIP RATING -->
        <div id="tab-rating" class="module-tab hidden space-y-5">
            <div class="bg-white p-4 rounded-xl border border-slate-200 flex justify-between items-center flex-wrap gap-3">
                <div>
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <i data-lucide="award" class="w-5 h-5 text-purple-600"></i> Модуль 4: Стипендіальний рейтинг ДТЕУ
                    </h2>
                    <p class="text-xs text-slate-500">Розрахунок загального балу: Академічний бал (90%) + Додаткові бали (до 10 балів)</p>
                </div>
                <button onclick="openAddPointModal()" class="bg-purple-600 hover:bg-purple-700 text-white text-xs font-semibold px-3 py-2 rounded-lg">
                    + Нарахувати додаткові бали
                </button>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 font-bold uppercase text-slate-500 border-b">
                        <tr>
                            <th class="p-3">Місце</th>
                            <th class="p-3">Студент</th>
                            <th class="p-3">Форма</th>
                            <th class="p-3">Академ. сер. бал</th>
                            <th class="p-3">Додаткові бали</th>
                            <th class="p-3 font-bold text-purple-700">Загальний рейтинг</th>
                            <th class="p-3">Стипендія</th>
                        </tr>
                    </thead>
                    <tbody id="rating-table-body" class="divide-y divide-slate-100">
                        <!-- Populated by JS -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- MODULE 5: MILITARY & OFFICIAL DOCS -->
        <div id="tab-military" class="module-tab hidden space-y-5">
            <div class="bg-white p-4 rounded-xl border border-slate-200 flex justify-between items-center flex-wrap gap-3">
                <div>
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <i data-lucide="shield" class="w-5 h-5 text-orange-600"></i> Модуль 5: Військовий облік та видача документів
                    </h2>
                    <p class="text-xs text-slate-500">Військовозобов'язані (ТЦК та СП) та журнал видачі студентських/індивідуальних планів під підпис</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Military Registry -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 space-y-3">
                    <h3 class="font-bold text-sm text-slate-800 flex items-center gap-2">
                        <i data-lucide="file-check" class="w-4 h-4 text-orange-500"></i> Стан військового обліку хлопців
                    </h3>
                    <div id="military-registry-container" class="space-y-2">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Docs Issuance Log -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 space-y-3">
                    <h3 class="font-bold text-sm text-slate-800 flex items-center gap-2">
                        <i data-lucide="check-square" class="w-4 h-4 text-blue-500"></i> Відомість видачі документів під підпис
                    </h3>
                    <div id="docs-issuance-container" class="space-y-2">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>
        </div>

        <!-- MODULE 6: SOCIAL PASSPORT & CASES -->
        <div id="tab-social" class="module-tab hidden space-y-5">
            <div class="bg-white p-4 rounded-xl border border-slate-200 flex justify-between items-center flex-wrap gap-3">
                <div>
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <i data-lucide="heart-handshake" class="w-5 h-5 text-rose-600"></i> Модуль 6: Соціальний паспорт та Case Management
                    </h2>
                    <p class="text-xs text-slate-500">Захищений реєстр пільговиків, профспілкові заяви та журнал конфіденційних звернень</p>
                </div>
                <button onclick="openAddCaseModal()" class="bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold px-3 py-2 rounded-lg">
                    + Зафіксувати випадок / Матдопомогу
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Social Passport -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 space-y-3">
                    <h3 class="font-bold text-sm text-slate-800">Соціальний паспорт групи 1-5</h3>
                    <div id="social-passport-container" class="space-y-2">
                        <!-- Populated by JS -->
                    </div>
