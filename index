    <!-- SCRIPT: ENGINE & STATE MANAGEMENT -->
    <script>
        const STORAGE_KEY = 'SUTE_ECURATOR_FULL_DB_V1';

        const SAMPLE_STATE = {
            students: [
                {
                    id: 'st_1',
                    name: 'Коваленко Олександр Сергійович',
