                    housingSteps: { s1: true, s2: true, s3: true, s4: true, s5: true },
                    docsIssued: { idCard: true, studyPlan: true }
                },
                {
                    id: 'st_2',
                    name: 'Мельник Анна Вікторівна',
                    gender: 'Ж',
                    finance: 'Контракт',
                    needDorm: true,
                    benefit: 'ВПО',
                    dorm: 'Гуртожиток 2',
                    room: '204',
                    militaryStatus: 'Не підлягає (дівчина)',
                    gpa: 92.0,
                    extraPoints: 5.0,
                    absenceUnexcused: 18,
                    absenceExcused: 12,
                    debts: ['Вища математика (модуль 2)'],
                    housingSteps: { s1: true, s2: true, s3: false, s4: false, s5: false },
                    docsIssued: { idCard: true, studyPlan: false }
                },
                {
                    id: 'st_3',
                    name: 'Шевченко Богдан Юрійович',
                    gender: 'Ч',
                    finance: 'Бюджет',
                    needDorm: false,
                    benefit: 'Без пільг',
                    dorm: '-',
                    room: '-',
                    militaryStatus: 'Потребує оновлення даних',
                    gpa: 64.0,
                    extraPoints: 0.0,
                    absenceUnexcused: 32,
                    absenceExcused: 0,
                    debts: ['Макроекономіка (залік)', 'Іноземна мова (іспит)'],
                    housingSteps: { s1: false, s2: false, s3: false, s4: false, s5: false },
                    docsIssued: { idCard: false, studyPlan: false }
                }
            ],
            defects: [
                { id: 'df_1', room: 'Гуртожиток 3, кімн. 315', type: 'Сантехніка', desc: 'Протікає змішувач в умивальнику' }
            ],
            socialCases: [
                { id: 'sc_1', studentName: 'Мельник Анна', type: 'Матеріальна допомога', desc: 'Подано заяву на матдопомогу через статус ВПО' }
            ],
            curatorHours: [
                { id: 'ch_1', date: '01.09.2026', topic: 'Ознайомлення з корпоративною культурою та укриттями ДТЕУ', presence: '28/30' }
            ]
        };

        let appState = {};

        function loadState() {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (raw) {
                try {
                    appState = JSON.parse(raw);
                } catch(e) {
                    appState = JSON.parse(JSON.stringify(SAMPLE_STATE));
                }
            } else {
                appState = JSON.parse(JSON.stringify(SAMPLE_STATE));
                saveState();
            }
            renderApp();
        }

        function saveState() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
            renderApp();
        }

        function resetToSampleData() {
            if (confirm('Скинути всі дані на зразок для групи 1-5?')) {
                appState = JSON.parse(JSON.stringify(SAMPLE_STATE));
                saveState();
            }
        }

        function exportDatabase() {
            const blob = new Blob([JSON.stringify(appState, null, 2)], { type: 'application/json' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `eCurator_Group_1-5_${new Date().toISOString().slice(0,10)}.json`;
            a.click();
        }

        function importDatabase(e) {
            const file = e.target.files[0];
            if (!file) return;
            const r = new FileReader();
            r.onload = function(evt) {
                try {
                    appState = JSON.parse(evt.target.result);
                    saveState();
                    alert('Базу даних успішно завантажено!');
                } catch(err) {
                    alert('Помилка структури JSON');
                }
            };
            r.readAsText(file);
        }

        function switchTab(tabId) {
            document.querySelectorAll('.module-tab').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.module-tab').forEach(el => el.classList.remove('block'));
            document.getElementById(tabId).classList.remove('hidden');
            document.getElementById(tabId).classList.add('block');

            document.querySelectorAll('.nav-tab').forEach(btn => {
                btn.classList.remove('active-tab', 'text-white');
                btn.classList.add('text-slate-300');
            });
            const activeBtn = document.getElementById('btn-' + tabId);
            if (activeBtn) {
                activeBtn.classList.add('active-tab', 'text-white');
                activeBtn.classList.remove('text-slate-300');
            }
        }

        // RENDER MASTER
        function renderApp() {
            renderDashboard();
            renderHousingModule();
            renderAttendanceModule();
            renderAcademicModule();
            renderRatingModule();
            renderMilitaryModule();
            renderSocialModule();
            renderSafetyModule();
            renderReportsModule();
            lucide.createIcons();
        }

        // 1. DASHBOARD RENDER
        function renderDashboard() {
            const total = appState.students.length;
            const needDorm = appState.students.filter(s => s.needDorm).length;
            const settled = appState.students.filter(s => s.housingSteps && s.housingSteps.s5).length;
            const benefits = appState.students.filter(s => s.benefit !== 'Без пільг').length;
            
            // Risk group detector: debts > 0 OR unexcused > 20
            const riskStudents = appState.students.filter(s => (s.debts && s.debts.length > 0) || s.absenceUnexcused >= 20);
            
            document.getElementById('dash-stat-total').innerText = total;
            document.getElementById('dash-stat-dorm').innerText = `${settled}/${needDorm}`;
            document.getElementById('dash-stat-benefit').innerText = benefits;
            document.getElementById('dash-stat-risk').innerText = riskStudents.length;

            // Avg Attendance
            let totalUnexcused = appState.students.reduce((acc, s) => acc + (s.absenceUnexcused || 0), 0);
            let avgAtt = total > 0 ? Math.max(0, Math.round(100 - (totalUnexcused / (total * 30)) * 100)) : 100;
            document.getElementById('dash-stat-att').innerText = avgAtt + '%';

            // Stipend pool
            const stipCount = appState.students.filter(s => s.finance === 'Бюджет' && (s.gpa >= 75)).length;
            document.getElementById('dash-stat-stip').innerText = stipCount;

            // Alerts
            const alertsBox = document.getElementById('dash-alerts-container');
            alertsBox.innerHTML = '';
            
            if (riskStudents.length > 0) {
                const div = document.createElement('div');
                div.className = "bg-rose-50 border border-rose-200 p-3 rounded-xl flex items-center justify-between text-xs text-rose-800";
                div.innerHTML = `
                    <div class="flex items-center gap-2">
                        <i data-lucide="alert-triangle" class="w-4 h-4 text-rose-600"></i>
                        <span><b>Увага!</b> Виявлено <b>${riskStudents.length} студентів</b> у «Групі ризику» (хронічні пропуски або академборги).</span>
                    </div>
                    <button onclick="switchTab('tab-academic')" class="underline font-bold hover:text-rose-900">Переглянути списки</button>
                `;
                alertsBox.appendChild(div);
            }

            // Table
            const tbody = document.getElementById('dash-students-table');
            tbody.innerHTML = '';
            appState.students.forEach(s => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50";

                const isRisk = (s.debts && s.debts.length > 0) || s.absenceUnexcused >= 20;

                tr.innerHTML = `
                    <td class="p-3 font-semibold text-slate-800">
                        ${s.name} ${isRisk ? '<span class="text-[10px] bg-rose-100 text-rose-700 px-1.5 py-0.5 rounded font-bold">Ризик</span>' : ''}
                    </td>
                    <td class="p-3 text-slate-500">${s.finance} (${s.gender})</td>
                    <td class="p-3">${s.needDorm ? (s.housingSteps?.s5 ? '✅ ' : '⏳ ') + s.dorm + ', ' + s.room : '<span class="text-slate-400">Відмова</span>'}</td>
                    <td class="p-3"><span class="${s.absenceUnexcused >= 20 ? 'text-rose-600 font-bold' : ''}">${s.absenceUnexcused} пар</span></td>
                    <td class="p-3">${s.debts && s.debts.length > 0 ? `<b class="text-rose-600">${s.debts.length} борг.</b>` : '<span class="text-emerald-600 font-medium">Немає</span>'}</td>
                    <td class="p-3"><span class="px-2 py-0.5 rounded ${s.benefit !== 'Без пільг' ? 'bg-amber-100 text-amber-800 font-medium' : 'text-slate-400'}">${s.benefit}</span></td>
                    <td class="p-3 text-slate-500">${s.militaryStatus}</td>
                    <td class="p-3 text-right">
                        <button onclick="editStudent('${s.id}')" class="text-blue-600 hover:text-blue-800 p-1"><i data-lucide="edit" class="w-4 h-4"></i></button>
                        <button onclick="deleteStudent('${s.id}')" class="text-rose-600 hover:text-rose-800 p-1"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // 2. HOUSING RENDER
        function renderHousingModule() {
            const cards = document.getElementById('housing-live-cards');
            cards.innerHTML = '';

            const dormStudents = appState.students.filter(s => s.needDorm);
            dormStudents.forEach(s => {
                const card = document.createElement('div');
                card.className = "p-3 bg-slate-50 border rounded-xl flex flex-wrap justify-between items-center gap-3";

                card.innerHTML = `
                    <div>
                        <h4 class="font-bold text-slate-800 text-xs">${s.name}</h4>
                        <p class="text-[11px] text-slate-500">${s.dorm}, ${s.room} | Пільга: <b>${s.benefit}</b></p>
                    </div>
                    <div class="grid grid-cols-5 gap-1 text-[10px]">
                        <button onclick="toggleHousingStep('${s.id}', 's1')" class="p-1.5 rounded border ${s.housingSteps?.s1 ? 'bg-emerald-600 text-white font-bold' : 'bg-white text-slate-600'}">1. Ордер</button>
                        <button onclick="toggleHousingStep('${s.id}', 's2')" class="p-1.5 rounded border ${s.housingSteps?.s2 ? 'bg-emerald-600 text-white font-bold' : 'bg-white text-slate-600'}">2. Медпункт</button>
                        <button onclick="toggleHousingStep('${s.id}', 's3')" class="p-1.5 rounded border ${s.housingSteps?.s3 ? 'bg-emerald-600 text-white font-bold' : 'bg-white text-slate-600'}">3. Оплата</button>
                        <button onclick="toggleHousingStep('${s.id}', 's4')" class="p-1.5 rounded border ${s.housingSteps?.s4 ? 'bg-emerald-600 text-white font-bold' : 'bg-white text-slate-600'}">4. Договір</button>
                        <button onclick="toggleHousingStep('${s.id}', 's5')" class="p-1.5 rounded border ${s.housingSteps?.s5 ? 'bg-emerald-600 text-white font-bold' : 'bg-white text-slate-600'}">5. Кімната</button>
                    </div>
                `;
                cards.appendChild(card);
            });

            // Defects table
            const dt = document.getElementById('housing-defects-table');
            dt.innerHTML = '';
            appState.defects.forEach(d => {
                const item = document.createElement('div');
                item.className = "p-2 bg-slate-50 border rounded-lg flex justify-between items-center text-xs";
                item.innerHTML = `
                    <div>
                        <b>${d.room}</b> <span class="text-amber-700 font-semibold">(${d.type})</span>: ${d.desc}
                    </div>
                    <button onclick="deleteDefect('${d.id}')" class="text-rose-500 hover:text-rose-700 font-bold">&times;</button>
                `;
                dt.appendChild(item);
            });
        }

        function toggleHousingStep(id, stepKey) {
            const st = appState.students.find(s => s.id === id);
            if (st) {
                if (!st.housingSteps) st.housingSteps = {};
                st.housingSteps[stepKey] = !st.housingSteps[stepKey];
                saveState();
            }
        }

        // 3. ATTENDANCE RENDER
        function renderAttendanceModule() {
            const tbody = document.getElementById('attendance-table-body');
            tbody.innerHTML = '';
            appState.students.forEach(s => {
                const totalPairs = (s.absenceUnexcused || 0) + (s.absenceExcused || 0);
                const percent = Math.min(100, Math.round((totalPairs / 60) * 100));
                const isCrit = s.absenceUnexcused >= 20;

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50";
                tr.innerHTML = `
                    <td class="p-3 font-semibold text-slate-800">${s.name}</td>
                    <td class="p-3">${totalPairs} пар</td>
                    <td class="p-3 font-bold ${isCrit ? 'text-rose-600' : 'text-slate-700'}">${s.absenceUnexcused || 0}</td>
                    <td class="p-3 text-emerald-700 font-medium">${s.absenceExcused || 0}</td>
                    <td class="p-3 font-bold">${percent}%</td>
                    <td class="p-3">${isCrit ? '<span class="px-2 py-0.5 rounded bg-rose-100 text-rose-800 font-bold text-[10px]">КРИТИЧНО (>20)</span>' : '<span class="text-emerald-600">Норма</span>'}</td>
                    <td class="p-3 text-right">
                        <button onclick="addAbsenceToStudent('${s.id}')" class="text-xs bg-slate-100 hover:bg-slate-200 px-2 py-1 rounded font-medium">+ Пропуск</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function addAbsenceToStudent(id) {
            const st = appState.students.find(s => s.id === id);
            if (st) {
                st.absenceUnexcused = (st.absenceUnexcused || 0) + 2;
                saveState();
            }
        }

        // 4. ACADEMIC RENDER
        function renderAcademicModule() {
            const debtsList = document.getElementById('debts-list-container');
            debtsList.innerHTML = '';

            const riskList = document.getElementById('academic-risk-container');
            riskList.innerHTML = '';

            appState.students.forEach(s => {
                if (s.debts && s.debts.length > 0) {
                    const item = document.createElement('div');
                    item.className = "p-2.5 bg-rose-50 border border-rose-200 rounded-lg text-xs space-y-1";
                    item.innerHTML = `
                        <div class="flex justify-between font-bold text-rose-900">
                            <span>${s.name}</span>
                            <span>${s.debts.length} борг.</span>
                        </div>
                        <p class="text-rose-700">${s.debts.join(', ')}</p>
                    `;
                    debtsList.appendChild(item);
                }

                if ((s.debts && s.debts.length > 0) || s.absenceUnexcused >= 20) {
                    const rItem = document.createElement('div');
                    rItem.className = "p-2.5 bg-slate-50 border rounded-lg text-xs flex justify-between items-center";
                    rItem.innerHTML = `
                        <div>
                            <b>${s.name}</b>
                            <p class="text-slate-500 text-[10px]">Борги: ${s.debts?.length || 0} | Пропуски: ${s.absenceUnexcused} пар</p>
                        </div>
                        <span class="text-[10px] bg-rose-600 text-white font-bold px-2 py-0.5 rounded">Ризик відрахування</span>
                    `;
                    riskList.appendChild(rItem);
                }
            });
        }

        // 5. RATING RENDER
        function renderRatingModule() {
            const tbody = document.getElementById('rating-table-body');
            tbody.innerHTML = '';

            // Clone and calculate total
            const list = appState.students.map(s => {
                const total = ((s.gpa || 60) * 0.9) + (s.extraPoints || 0);
                return { ...s, totalScore: parseFloat(total.toFixed(2)) };
            }).sort((a, b) => b.totalScore - a.totalScore);

            list.forEach((s, idx) => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50";

                const isStip = s.finance === 'Бюджет' && idx < 2;

                tr.innerHTML = `
                    <td class="p-3 font-bold">${idx + 1}</td>
                    <td class="p-3 font-semibold text-slate-800">${s.name}</td>
                    <td class="p-3 text-slate-500">${s.finance}</td>
                    <td class="p-3">${s.gpa || '-'}</td>
                    <td class="p-3 text-purple-700 font-bold">+${s.extraPoints || 0}</td>
                    <td class="p-3 font-black text-slate-900">${s.totalScore}</td>
                    <td class="p-3">${isStip ? '<span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold text-[10px]">Академічна стипендія</span>' : '<span class="text-slate-400">-</span>'}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // 6. MILITARY RENDER
        function renderMilitaryModule() {
            const mc = document.getElementById('military-registry-container');
            mc.innerHTML = '';

            const dc = document.getElementById('docs-issuance-container');
            dc.innerHTML = '';

            appState.students.forEach(s => {
                if (s.gender === 'Ч') {
                    const item = document.createElement('div');
                    item.className = "p-2 bg-slate-50 border rounded-lg flex justify-between items-center text-xs";
                    item.innerHTML = `
                        <b>${s.name}</b>
                        <span class="px-2 py-0.5 rounded font-semibold text-[10px] ${s.militaryStatus === 'Взято на облік ДТЕУ' ? 'bg-emerald-100 text-emerald-800' : 'bg-orange-100 text-orange-800'}">${s.militaryStatus}</span>
                    `;
                    mc.appendChild(item);
                }

                const dItem = document.createElement('div');
                dItem.className = "p-2 bg-slate-50 border rounded-lg flex justify-between items-center text-xs";
                dItem.innerHTML = `
                    <span>${s.name}</span>
                    <div class="space-x-1">
                        <button onclick="toggleDoc('${s.id}', 'idCard')" class="px-2 py-0.5 rounded text-[10px] ${s.docsIssued?.idCard ? 'bg-emerald-600 text-white font-bold' : 'bg-slate-200 text-slate-600'}">Квиток</button>
                        <button onclick="toggleDoc('${s.id}', 'studyPlan')" class="px-2 py-0.5 rounded text-[10px] ${s.docsIssued?.studyPlan ? 'bg-emerald-600 text-white font-bold' : 'bg-slate-200 text-slate-600'}">Інд. план</button>
                    </div>
                `;
                dc.appendChild(dItem);
            });
        }

        function toggleDoc(id, docKey) {
            const st = appState.students.find(s => s.id === id);
            if (st) {
                if (!st.docsIssued) st.docsIssued = {};
                st.docsIssued[docKey] = !st.docsIssued[docKey];
                saveState();
            }
        }

        // 7. SOCIAL RENDER
        function renderSocialModule() {
            const sc = document.getElementById('social-passport-container');
            sc.innerHTML = '';

            const cc = document.getElementById('social-cases-container');
            cc.innerHTML = '';

            const benefits = appState.students.filter(s => s.benefit !== 'Без пільг');
            benefits.forEach(s => {
                const item = document.createElement('div');
                item.className = "p-2 bg-amber-50 border border-amber-200 rounded-lg text-xs flex justify-between items-center";
                item.innerHTML = `
                    <b>${s.name}</b>
                    <span class="font-bold text-amber-800 text-[10px]">${s.benefit}</span>
                `;
                sc.appendChild(item);
            });

            appState.socialCases.forEach(c => {
                const cItem = document.createElement('div');
                cItem.className = "p-2 bg-slate-50 border rounded-lg text-xs space-y-0.5";
                cItem.innerHTML = `
                    <div class="flex justify-between font-bold">
                        <span>${c.studentName}</span>
                        <span class="text-rose-600 text-[10px]">${c.type}</span>
                    </div>
                    <p class="text-slate-600 text-[11px]">${c.desc}</p>
                `;
                cc.appendChild(cItem);
            });
        }

        // 8. SAFETY RENDER
        function renderSafetyModule() {
            const mc = document.getElementById('curator-meetings-list');
            mc.innerHTML = '';
            appState.curatorHours.forEach(m => {
                const item = document.createElement('div');
                item.className = "p-2 bg-slate-50 border rounded-lg text-xs";
                item.innerHTML = `
                    <div class="flex justify-between font-bold text-teal-800">
                        <span>${m.topic}</span>
                        <span>${m.date}</span>
                    </div>
                    <span class="text-slate-500 text-[10px]">Присутність: ${m.presence}</span>
                `;
                mc.appendChild(item);
            });
        }

        // 9. REPORTS RENDER
        function renderReportsModule() {
            const total = appState.students.length;
            const settled = appState.students.filter(s => s.housingSteps?.s5).length;
            const noDebt = appState.students.filter(s => !s.debts || s.debts.length === 0).length;
            const successRate = total > 0 ? Math.round((noDebt / total) * 100) : 100;

            document.getElementById('rep-kpi-total').innerText = total + ' осіб';
            document.getElementById('rep-kpi-dorm').innerText = settled + ' осіб';
            document.getElementById('rep-kpi-success').innerText = successRate + '%';

            document.getElementById('rep-att-text').innerText = `За звітний період середній рівень відвідуваності занять студентами академічної групи 1-5 становить 92%. Хронічних систематичних порушників дисципліни, окрім студентів групи ризику, не виявлено.`;

            // Risk list
            const rList = document.getElementById('rep-risk-list');
            rList.innerHTML = '';
            const risks = appState.students.filter(s => (s.debts && s.debts.length > 0) || s.absenceUnexcused >= 20);
            risks.forEach(r => {
                const li = document.createElement('li');
                li.innerHTML = `<b>${r.name}</b>: академборги (${r.debts?.join(', ') || 'немає'}), пропуски занять без поважних причин (${r.absenceUnexcused} пар).`;
                rList.appendChild(li);
            });

            // Benefit list
            const bList = document.getElementById('rep-benefit-list');
            bList.innerHTML = '';
            appState.students.filter(s => s.benefit !== 'Без пільг').forEach(b => {
                const li = document.createElement('li');
                li.innerHTML = `<b>${b.name}</b> — категорія: <i>${b.benefit}</i> (документи верифіковано).`;
                bList.appendChild(li);
            });

            // Print Sync
            document.getElementById('print-content').innerHTML = `
                <p><b>1. Контингент групи:</b> ${total} осіб (Бюджет: ${appState.students.filter(s=>s.finance==='Бюджет').length}, Контракт: ${appState.students.filter(s=>s.finance==='Контракт').length}).</p>
                <p><b>2. Поселення в гуртожитки:</b> Успішно заселено ${settled} осіб.</p>
                <p><b>3. Академічна успішність:</b> Якісний показник успішності становить ${successRate}%.</p>
                <p><b>4. Студенти групи ризику:</b> ${risks.map(r=>r.name).join(', ') || 'Відсутні'}.</p>
            `;
        }

        // GLOBAL SEARCH
        function handleGlobalSearch(query) {
            if (!query.trim()) {
                renderDashboard();
                return;
            }
            const q = query.toLowerCase();
            const filtered = appState.students.filter(s => s.name.toLowerCase().includes(q));
            
            const tbody = document.getElementById('dash-students-table');
            tbody.innerHTML = '';
            filtered.forEach(s => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-3 font-semibold text-slate-800">${s.name}</td>
                    <td class="p-3 text-slate-500">${s.finance} (${s.gender})</td>
                    <td class="p-3">${s.needDorm ? s.dorm + ', ' + s.room : 'Відмова'}</td>
                    <td class="p-3">${s.absenceUnexcused} пар</td>
                    <td class="p-3">${s.debts?.length || 0} борг.</td>
                    <td class="p-3">${s.benefit}</td>
                    <td class="p-3">${s.militaryStatus}</td>
                    <td class="p-3 text-right">
                        <button onclick="editStudent('${s.id}')" class="text-blue-600 p-1"><i data-lucide="edit" class="w-4 h-4"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
            lucide.createIcons();
        }

        // MODALS
        function openStudentModal() {
            document.getElementById('student-form').reset();
            document.getElementById('form-stud-id').value = '';
            document.getElementById('student-modal-title').innerText = 'Додати студента до групи 1-5';
            document.getElementById('student-modal').classList.remove('hidden');
        }

        function editStudent(id) {
            const s = appState.students.find(st => st.id === id);
            if (!s) return;
            document.getElementById('form-stud-id').value = s.id;
            document.getElementById('form-stud-name').value = s.name;
            document.getElementById('form-stud-gender').value = s.gender;
            document.getElementById('form-stud-finance').value = s.finance;
            document.getElementById('form-stud-need-dorm').value = s.needDorm ? 'true' : 'false';
            document.getElementById('form-stud-benefit').value = s.benefit;
            document.getElementById('form-stud-dorm').value = s.dorm || '';
            document.getElementById('form-stud-room').value = s.room || '';
            document.getElementById('form-stud-military').value = s.militaryStatus;
            document.getElementById('form-stud-gpa').value = s.gpa || 75;

            document.getElementById('student-modal-title').innerText = 'Редагувати студента';
            document.getElementById('student-modal').classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        function saveStudentForm(e) {
            e.preventDefault();
            const id = document.getElementById('form-stud-id').value || ('st_' + Date.now());
            const existing = appState.students.find(s => s.id === id);

            const studentObj = {
                id,
                name: document.getElementById('form-stud-name').value,
                gender: document.getElementById('form-stud-gender').value,
                finance: document.getElementById('form-stud-finance').value,
                needDorm: document.getElementById('form-stud-need-dorm').value === 'true',
                benefit: document.getElementById('form-stud-benefit').value,
                dorm: document.getElementById('form-stud-dorm').value || '-',
                room: document.getElementById('form-stud-room').value || '-',
                militaryStatus: document.getElementById('form-stud-military').value,
                gpa: parseFloat(document.getElementById('form-stud-gpa').value) || 75.0,
                extraPoints: existing ? existing.extraPoints : 0.0,
                absenceUnexcused: existing ? existing.absenceUnexcused : 0,
                absenceExcused: existing ? existing.absenceExcused : 0,
                debts: existing ? existing.debts : [],
                housingSteps: existing ? existing.housingSteps : { s1: false, s2: false, s3: false, s4: false, s5: false },
                docsIssued: existing ? existing.docsIssued : { idCard: false, studyPlan: false }
            };

            if (existing) {
                const idx = appState.students.findIndex(s => s.id === id);
                appState.students[idx] = studentObj;
            } else {
                appState.students.push(studentObj);
            }

            closeModal('student-modal');
            saveState();
        }

        function deleteStudent(id) {
            if (confirm('Видалити студента з реєстру?')) {
                appState.students = appState.students.filter(s => s.id !== id);
                saveState();
            }
        }

        function openDefectModal() {
            document.getElementById('defect-modal').classList.remove('hidden');
        }

        function saveDefectForm(e) {
            e.preventDefault();
            const def = {
                id: 'df_' + Date.now(),
                room: document.getElementById('def-room').value,
                type: document.getElementById('def-type').value,
                desc: document.getElementById('def-desc').value
            };
            appState.defects.unshift(def);
            closeModal('defect-modal');
            saveState();
        }

        function deleteDefect(id) {
            appState.defects = appState.defects.filter(d => d.id !== id);
            saveState();
        }

        window.onload = function() {
            loadState();
        };
    </script>
</body>
</html>
